# .env.example
# Copy this file to .env and fill in your actual credentials.
# DO NOT commit your actual .env file to GitHub!

# Toggle to use the live database (set to True or 1)
USE_LIVE_DATABASE=True

# Azure SQL Connection String
# Replace your_username and your_password
FABRIC_SQL_CONNECTION=Driver={ODBC Driver 17 for SQL Server};Server=tcp:holyoketire.database.windows.net,1433;Database=pos_replica;Uid=your_username;Pwd=your_password;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;
